[init]
	defaultBranch = main
[core]
	editor = nvim
	excludesfile = ~/.gitignore_global
[alias]
	mg = merge
	mn = merge --no-ff
	co = checkout
	st = status
	ca = commit --amend
	aa = add --all
	ai = add -i
	ap = add -p
	ae = add -e
	ci = commit
	br = branch
	ba = branch --all
	df = diff
	ds = diff --staged
	ph = push
	pl = pull
	ft = fetch
	rv = revert
	lg = log
	lo = log --oneline
	graph = log --all --graph --decorate --oneline
[user]
	name = Thitiwut Chutipongwanit
	email = thitiwut.chu@gmail.com
[merge]
	conflictstyle = zdiff3
[mergetool]
	keepBackup = false
[http]
	connectTimeout = 5
[log]
	date = iso-local

